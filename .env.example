# ─────────────────────────────────────────────────────────────────────────────
#  AIDiscordServerEinrichten — Umgebungsvariablen
#
#  Kopieren nach .env (wird von Git ignoriert) oder direkt in Render unter
#  "Environment" eintragen. Nur DISCORD_BOT_TOKEN ist Pflicht.
# ─────────────────────────────────────────────────────────────────────────────

# ══ PFLICHT ═══════════════════════════════════════════════════════════════════
# https://discord.com/developers/applications → deine App → Bot → Reset Token
DISCORD_BOT_TOKEN=

# ══ Öffentlich erreichbare URL ════════════════════════════════════════════════
# Auf Render NICHT nötig: RENDER_EXTERNAL_URL wird automatisch gesetzt und
# verwendet. Nur setzen, wenn eine eigene Domain davor liegt.
# PUBLIC_URL=https://aidiscordserver.onrender.com

# ══ Bot-Verhalten (alles optional, Defaults stehen hier) ═════════════════════
# BOT_NAME=AIDiscordServerEinrichten
# COMMAND_NAME=connect
# ACTIVITY_TEXT=/connect · KI-Steuerung für deinen Server
# PRESENCE_STATUS=online

# ══ Netzwerk ═════════════════════════════════════════════════════════════════
# HOST=0.0.0.0
# Render setzt PORT selbst — hier nichts ändern.
# PORT=8080
# Wer das /console-Dashboard aufrufen darf. "*" = jeder mit Token.
# Für mehr Sicherheit auf die Arena-AI-Origin einschränken (kommagetrennt).
# ALLOWED_ORIGIN=*
# CONSOLE_ENABLED=true

# ══ Sitzungen (die Tokens aus /connect) ══════════════════════════════════════
# Gültigkeitsdauer in Stunden. 0 = unbegrenzt (nicht empfohlen).
# SESSION_TTL_HOURS=24
# Wie viele Tokens pro Server gleichzeitig aktiv sein dürfen. Das älteste wird
# automatisch widerrufen, wenn das Limit erreicht ist.
# MAX_SESSIONS_PER_GUILD=5
# Tokens überleben einen Neustart, wenn PERSIST_SESSIONS=true ist und DATA_DIR
# auf einem persistenten Volume liegt (auf Render Free flüchtig).
# PERSIST_SESSIONS=true
# DATA_DIR=data

# ══ Schutzlimits der API ═════════════════════════════════════════════════════
# Anfragen pro Token innerhalb des Fensters. Danach HTTP 429 mit retry_after.
# API_RATE_LIMIT=240
# API_RATE_WINDOW=60
# Maximale Body-Größe in Bytes (8 MB reichen für Icons/Banner als Base64).
# MAX_BODY_BYTES=8388608
# MAX_MESSAGE_HISTORY=100
# MAX_MEMBER_FETCH=1000

# ══ Login bei 429 / Cloudflare-Bann (Error 1015) ═════════════════════════════
# Discord liegt hinter Cloudflare. Wird die AUSGEHENDE IP des Containers
# gesperrt (auf Free-Plänen teilen sich viele Kunden eine IP), antwortet jede
# Anfrage mit 429 + HTML-Seite. Der Bot erkennt das, misst mit einem tokenlosen
# Aufruf von https://discord.com/api/v10/gateway nach und loggt sich sofort ein,
# sobald die Sperre fällt. Diagnose jederzeit: GET /api/diagnostics
#
# Abstand der tokenlosen Proben während einer Sperre (5–600 s).
# BAN_PROBE_INTERVAL_SECONDS=30
# So lange wird eine Sperre beobachtet, bevor der Prozess sich beendet und die
# Plattform einen frischen Container (⇒ andere ausgehende IP) startet. 0 = nie.
# BAN_WATCH_SECONDS=600
# Neustart bei dauerhaft gesperrter IP an/aus (Exit-Code 3).
# RESTART_ON_IP_BAN=true
# Pause vor diesem bewussten Neustart.
# RESTART_DELAY_SECONDS=30
# Zeitgrenze der Start-Diagnose.
# NETCHECK_TIMEOUT_SECONDS=8

# Backoff nach ANDEREN Login-Fehlern (exponentiell, mit Jitter, gedeckelt).
# LOGIN_RETRY_BASE_SECONDS=15
# LOGIN_RETRY_MAX_SECONDS=600
# Wartezeit nach fatalen Fehlern (ungültiges Token, Gateway-Code 4004 …).
# Der Prozess beendet sich dabei bewusst NICHT (kein Crash-Loop, kein Login-Spam).
# FATAL_RETRY_SECONDS=300

# ══ Eigene ausgehende IP (dauerhafte Lösung bei gesperrten Cloud-IPs) ════════
# HTTP(S)-Proxy für ALLE Discord-Verbindungen (REST und Gateway). Discord sieht
# dann nur noch die Proxy-IP — damit sind geteilte/verbrannte Render-IPs egal.
# Anbieter mit statischen IPs: QuotaGuard Static, Proxyium, eigener VPS mit squid.
# DISCORD_PROXY=http://user:pass@host:port
# Zugangsdaten alternativ zur URL:
# DISCORD_PROXY_USER=
# DISCORD_PROXY_PASSWORD=

# ══ Betrieb ══════════════════════════════════════════════════════════════════
# LOG_LEVEL=INFO
# Braucht "SERVER MEMBERS INTENT" + "MESSAGE CONTENT INTENT" im Developer Portal.
# Ist der Schalter aus, startet der Bot automatisch ohne sie und bleibt online.
# PRIVILEGED_INTENTS=true
# Faktor für Cache-Wartezeiten nach Schreibaktionen. 0 nur für Tests!
# SETTLE_SCALE=1.0
