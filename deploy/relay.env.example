# ─────────────────────────────────────────────────────────────────────────────
#  AIDiscordServerEinrichten — Umgebung für den Betrieb auf einem eigenen Server
#
#    cp relay.env.example relay.env && nano relay.env
#
#  relay.env ist von Git ausgeschlossen (.gitignore: .env.*, *.env) — das Token
#  landet also niemals im Repo. Gelesen von:
#    · deploy/docker-compose.yml   (env_file)
#    · deploy/relay.service        (EnvironmentFile, systemd ohne Docker)
# ─────────────────────────────────────────────────────────────────────────────

# ══ PFLICHT ═══════════════════════════════════════════════════════════════════
# https://discord.com/developers/applications → deine App → Bot → Reset Token
DISCORD_BOT_TOKEN=

# ══ Öffentliche URL (Pflicht außerhalb von Render) ════════════════════════════
# Genau die Adresse, unter der Arena AI den Relay erreicht — MIT https://, OHNE
# Slash am Ende. Sie steht später in jedem /connect-Prompt.
#   Mit Caddy (empfohlen):   https://relay.deine-domain.tld
#   Ohne Domain/TLS:         http://<Server-IPv4>:8080
PUBLIC_URL=https://relay.deine-domain.tld

# Nur für Caddy (docker-compose.yml): Hostname für das Let's-Encrypt-Zertifikat.
# Muss zur PUBLIC_URL passen. Ohne Caddy einfach leer lassen.
RELAY_DOMAIN=relay.deine-domain.tld

# ══ Betrieb (sinnvolle Defaults, normalerweise nichts ändern) ═════════════════
LOG_LEVEL=INFO
SESSION_TTL_HOURS=24
MAX_SESSIONS_PER_GUILD=5
PRIVILEGED_INTENTS=true
CONSOLE_ENABLED=true
ALLOWED_ORIGIN=*

# Eigene IP ⇒ ein Neustart bringt keine andere Adresse. Deshalb aus:
RESTART_ON_IP_BAN=false
# Sollte discord.com trotzdem je gesperrt sein (extrem selten bei eigener IP,
# dann meist ein Token-Problem): alle 30 s tokenlos proben, sofort einloggen.
BAN_PROBE_INTERVAL_SECONDS=30
BAN_WATCH_SECONDS=0

# ══ Nur für die systemd-Variante (relay.service) ══════════════════════════════
# Docker setzt diese Werte selbst; unter systemd müssen sie hier stehen.
HOST=0.0.0.0
PORT=8080
DATA_DIR=/var/lib/adse-relay
PERSIST_SESSIONS=true

# ══ Optional: HTTP-Proxy für Discord (hier normalerweise NICHT nötig) ═════════
# DISCORD_PROXY=http://user:pass@host:3128
# DISCORD_PROXY_USER=
# DISCORD_PROXY_PASSWORD=
